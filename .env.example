# ╔══════════════════════════════════════════════════════════╗
# ║         MINI DENTSU MD — Environment Configuration      ║
# ║                  By DENTSU'S TECH                        ║
# ║   Copy this file to .env and fill in your values         ║
# ╚══════════════════════════════════════════════════════════╝

# Server Port (default: 8000)
PORT=8000

# ─── GitHub Session Storage (REQUIRED) ───────────────────────
# Your GitHub Personal Access Token (with repo permissions)
GITHUB_TOKEN=ghp_yourTokenHere

# GitHub username or organization that owns the session repo
GITHUB_OWNER=your_github_username

# Name of the GitHub repo used to store WhatsApp sessions
GITHUB_REPO=my-session-storage

# ─── Bot Owner ───────────────────────────────────────────────
# Your WhatsApp number with country code (NO + sign)
OWNER_NUMBER=2420000000000

# ─── Bot Settings ─────────────────────────────────────────────
# Command prefix (default: .)
PREFIX=.

# Node environment
NODE_ENV=production

# ─── Automation Features ──────────────────────────────────────
# Automatically view WhatsApp statuses: true / false
AUTO_VIEW_STATUS=true

# Automatically like WhatsApp statuses: true / false  
AUTO_LIKE_STATUS=true

# Show "recording..." presence to users: true / false
AUTO_RECORDING=true
